---
import { EVENTO } from '../config/evento';
const pix = EVENTO.preco / 100;
const { href = '#inscricao' } = Astro.props;
---
<a class="ticket" href={href} aria-label={`Passaporte: R$ ${pix} no Pix. Garanta o seu`}>
  <div class="parte canhoto">
    <span class="titulo">Passaporte</span>
    <span class="rotulo">3 dias de festival</span>
  </div>
  <div class="parte preco">
    <span class="display valor"><small>R$</small>{pix}<sup>*</sup></span>
    <span class="rotulo">*no Pix</span>
  </div>
  <div class="parte cta">
    <span class="rotulo">Garanta o seu</span>
    <span class="acao">Inscreva-se →</span>
  </div>
</a>
<style>
  .ticket { --furo: 12px; --l: 2px solid var(--verde); --p: 2px dotted var(--verde); display: grid; grid-template-columns: 1fr 1.3fr 1.5fr; text-decoration: none; color: var(--verde); position: relative; }
  .parte { background: var(--papel); border-top: var(--l); border-bottom: var(--l); padding: 20px 22px; display: flex; flex-direction: column; justify-content: center; gap: 6px; position: relative; }
  .canhoto { border-left: var(--l); }
  .preco { border-right: var(--p); align-items: center; }
  .cta { border-right: var(--l); border-left: var(--p); margin-left: -2px; transform-origin: 0% 100%; will-change: transform; }
  .preco { border-left: var(--p); margin-left: -2px; }
  .preco::before, .preco::after, .cta::before, .cta::after { content: ''; position: absolute; left: calc(var(--furo) * -1 - 1px); width: calc(var(--furo) * 2); height: var(--furo); background: var(--amarelo); border: 2px solid var(--verde); }
  .preco::before, .cta::before { top: -2px; border-top: 0; border-radius: 0 0 var(--furo) var(--furo); }
  .preco::after, .cta::after { bottom: -2px; border-bottom: 0; border-radius: var(--furo) var(--furo) 0 0; }
  .titulo { font-family: var(--display); font-weight: 900; font-size: 20px; text-transform: uppercase; letter-spacing: .03em; }
  .valor { font-size: 68px; display: flex; align-items: flex-start; }
  .valor small { font-size: 26px; margin: 5px 5px 0 0; }
  .valor sup { font-size: 30px; line-height: 1; }
  .acao { font-family: var(--display); font-weight: 900; font-stretch: 75%; font-size: 34px; color: var(--laranja); line-height: 1; }
  .ticket:focus-visible { outline: 3px solid var(--laranja); outline-offset: 6px; }
  @media (max-width: 640px) {
    .ticket { grid-template-columns: 1fr 1fr; }
    .preco { border-right: var(--l); }
    .canhoto, .preco { border-bottom: var(--p); }
    .cta { grid-column: 1 / -1; margin: -2px 0 0; border-left: var(--l); border-top: var(--p); align-items: center; transform-origin: 0% 0%; }
    .preco::after, .cta::before, .cta::after { display: none; }
    .valor { font-size: 52px; }
  }
  @media (max-width: 400px) { .parte { padding: 16px 14px; } .valor { font-size: 42px; } .valor small { font-size: 20px; } .valor sup { font-size: 22px; } .titulo { font-size: 17px; } }
</style>
<script>
  import { gsap } from 'gsap';
  // Destaca o canhoto "Inscreva-se" pela linha pontilhada: abre de cima para baixo (ou da direita para a esquerda no celular).
  gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<HTMLElement>('.ticket').forEach((t) => {
      const cta = t.querySelector<HTMLElement>('.cta');
      if (!cta) return;
      const empilhado = () => matchMedia('(max-width: 640px)').matches;
      const abrir = () => (empilhado() ? { rotation: 2.5, x: 4, y: 10 } : { rotation: 4, x: 12, y: 0 });
      const destacar = () => gsap.to(cta, { ...abrir(), duration: 0.45, ease: 'power3.out', overwrite: true });
      const voltar = () => gsap.to(cta, { rotation: 0, x: 0, y: 0, duration: 0.6, ease: 'power3.inOut', overwrite: true });
      t.addEventListener('mouseenter', destacar);
      t.addEventListener('focus', destacar);
      t.addEventListener('mouseleave', voltar);
      t.addEventListener('blur', voltar);
      // Aviso na entrada: destaca um pouco e volta, para mostrar que é destacável.
      gsap.timeline({ delay: 1.6 })
        .to(cta, { ...abrir(), duration: 0.5, ease: 'power3.out' })
        .to(cta, { rotation: 0, x: 0, y: 0, duration: 0.8, ease: 'power3.inOut' }, '+=0.35');
    });
  });
</script>
