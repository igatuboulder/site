---
interface Props { rotulo: string; titulo: string }
const { rotulo, titulo } = Astro.props;
---
<header class="cab grade">
  <span class="sol" aria-hidden="true"></span>
  <div class="dentro">
    <p class="rotulo">{rotulo}</p>
    <h1 class="display">{titulo}</h1>
    <slot />
  </div>
</header>
<style>
  .cab { position: relative; overflow: hidden; padding: clamp(48px, 8vw, 96px) var(--margem) clamp(32px, 5vw, 56px); }
  .dentro { position: relative; max-width: 1100px; margin: 0 auto; }
  .sol { position: absolute; right: clamp(-60px, 4vw, 8vw); bottom: clamp(-140px, -9vw, -60px); width: clamp(160px, 26vw, 340px); aspect-ratio: 1; border-radius: 50%; background: var(--sol); }
  @media (max-width: 600px) { .sol { width: 110px; right: -24px; bottom: -48px; } }
  h1 { font-size: var(--t-titulo); color: var(--verde); text-transform: uppercase; margin: 0.18em 0 0; text-wrap: balance; }
</style>
