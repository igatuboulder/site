---
interface Props { rotulo: string; titulo: string }
const { rotulo, titulo } = Astro.props;
---
<header class="cab grade">
  <div class="dentro">
    <p class="rotulo">{rotulo}</p>
    <h1 class="display">{titulo}</h1>
    <slot />
  </div>
</header>
<style>
  .cab { padding: clamp(48px, 8vw, 96px) var(--margem) clamp(32px, 5vw, 56px); }
  .dentro { max-width: 1100px; margin: 0 auto; }
  h1 { font-size: clamp(56px, 11vw, 140px); color: var(--verde); text-transform: uppercase; margin: 8px 0 0; }
</style>
