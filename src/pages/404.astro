---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
---
<Base titulo="Página não encontrada" descricao="Essa página não existe no site do Festival IgatuBoulder.">
  <Cabecalho rotulo="Erro 404" titulo="Essa trilha não existe" />
  <section class="secao papel">
    <div class="conteudo">
      <p class="lead">O endereço pode ter mudado. Volte para a <a href="/">página inicial</a> ou vá direto para a <a href="/inscricao">inscrição</a>.</p>
    </div>
  </section>
</Base>
