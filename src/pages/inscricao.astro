---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import FormInscricao from '../components/FormInscricao.astro';
import { EVENTO } from '../config/evento';
import { formatarReais, precoEmCentavos, TAXA_CARTAO } from '../lib/preco';
---
<Base titulo="Inscrição" descricao={`Garanta seu passaporte para o ${EVENTO.edicao}º Festival IgatuBoulder.`}>
  <Cabecalho rotulo="Inscrição" titulo="Garanta seu passaporte" />
  <section class="secao papel">
    <div class="conteudo duas">
      <div class="texto">
        <p>O passaporte vale para os 3 dias de festival, de {EVENTO.datas}.</p>
        <dl class="precos">
          <div><dt>Pix</dt><dd class="display">{formatarReais(precoEmCentavos('pix'))}</dd></div>
          <div><dt>Cartão</dt><dd class="display">{formatarReais(precoEmCentavos('cartao'))}</dd></div>
        </dl>
        <p class="nota">No cartão o valor inclui a taxa da maquininha ({(TAXA_CARTAO * 100).toLocaleString('pt-BR')}%). O pagamento é feito pela InfinitePay, em ambiente seguro.</p>
        <p class="nota">Dúvidas: <a href={`mailto:${EVENTO.email}`}>{EVENTO.email}</a></p>
      </div>
      <FormInscricao />
    </div>
  </section>
</Base>
<style>
  .precos { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 24px 0; }
  .precos div { border: 2px solid var(--verde); padding: 14px 16px; }
  dt { font-size: 11px; letter-spacing: .16em; font-weight: 600; text-transform: uppercase; }
  dd { margin: 4px 0 0; font-size: 44px; color: var(--verde); }
  .nota { font-size: 14px; }
</style>
