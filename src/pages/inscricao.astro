---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import FormInscricao from '../components/FormInscricao.astro';
import { EVENTO } from '../config/evento';
import { formatarReais, PRECO_PASSAPORTE } from '../lib/preco';
---
<Base titulo="Inscrição" descricao={`Garanta seu passaporte para o ${EVENTO.edicao}º Festival IgatuBoulder.`}>
  <Cabecalho rotulo="Inscrição" titulo="Garanta seu passaporte" />
  <section class="secao papel">
    <div class="conteudo duas">
      <div class="texto">
        <p>O passaporte vale para os 3 dias de festival, de {EVENTO.datas}.</p>
        <dl class="precos">
          <div><dt>Passaporte</dt><dd class="display">{formatarReais(PRECO_PASSAPORTE)}</dd></div>
        </dl>
        <p class="nota">Você escolhe Pix ou cartão na hora de pagar. No cartão, a taxa é acrescentada ao valor. O pagamento é feito pela InfinitePay, em ambiente seguro.</p>
        <p class="nota">Dúvidas? <a href="/contato">Fale com a gente</a></p>
      </div>
      <FormInscricao />
    </div>
  </section>
</Base>
<style>
  .precos { display: grid; grid-template-columns: minmax(0, 1fr); max-width: 320px; gap: 12px; margin: 24px 0; }
  .precos div { border: 2px solid var(--verde); padding: 14px 16px; }
  dt { font-size: 11px; letter-spacing: .16em; font-weight: 600; text-transform: uppercase; }
  dd { margin: 4px 0 0; font-size: clamp(30px, 9vw, 44px); white-space: nowrap; color: var(--verde); }
  .nota { font-size: 14px; }
</style>
