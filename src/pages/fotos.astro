---
import FotoAD from '../components/FotoAD.astro';
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import IconeInstagram from '../components/IconeInstagram.astro';
import { EVENTO } from '../config/evento';
import { FOTOS } from '../data/fotos';
import { agruparFotos, type Secao } from '../lib/fotos';
const TITULOS: Record<Secao, string> = { social: 'IgatuBoulder Social', escalada: 'Escalada', festival: 'O festival' };
const secoes = agruparFotos(FOTOS);
---
<Base titulo="Fotos" descricao="Fotos do Festival IgatuBoulder: IgatuBoulder Social, escalada e festival.">
  <Cabecalho rotulo="Fotos" titulo="Na pedra">
    <nav class="atalhos" aria-label="Seções de fotos">
      {secoes.map((s) => <a href={`#${s.secao}`}>{TITULOS[s.secao]}</a>)}
    </nav>
  </Cabecalho>
  {secoes.map((s, i) => (
    <section id={s.secao} class:list={['secao', i % 2 ? 'grade' : 'papel']}>
      <div class="conteudo">
        <h2 class="display h2">{TITULOS[s.secao]}</h2>
        {s.grupos.map((g) => (
          <div class="grupo">
            {g.setor && <h3 class="rotulo setor">Setor {g.setor}</h3>}
            <ul class="galeria">
              {g.fotos.map((f) => (
                <li class="revela">
                  <FotoAD class="galeria-img" arquivo={f.arquivo} ampliar widths={[400, 800]} sizes="(max-width: 760px) 50vw, 33vw" loading="lazy" />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ))}
  <section class="secao papel">
    <div class="conteudo">
      <a class="insta" href={`https://instagram.com/${EVENTO.instagram}`} target="_blank" rel="noopener">
        <IconeInstagram tamanho={32} />
        <span>Mais fotos no Instagram <strong>@{EVENTO.instagram}</strong></span>
      </a>
    </div>
  </section>
</Base>
<style>
  .atalhos { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .atalhos a { font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; text-decoration: none; color: var(--verde); border: 2px solid var(--verde); padding: 8px 12px; background: var(--papel); }
  .atalhos a:hover { background: var(--verde); color: var(--papel); }
  .grupo + .grupo { margin-top: 40px; }
  .setor { color: var(--verde); margin: 0 0 12px; }
  .galeria { list-style: none; margin: 0; padding: 0; columns: 3 240px; column-gap: 12px; }
  .galeria li { break-inside: avoid; margin: 0 0 12px; }
  .galeria-img { width: 100%; height: auto; border: 2px solid var(--verde); }
  .insta { display: inline-flex; align-items: center; gap: 14px; font-size: 18px; color: var(--verde); text-decoration: none; }
  .insta strong { color: var(--laranja); }
  .insta:hover strong { text-decoration: underline; }
</style>
