---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import { EVENTO } from '../config/evento';
const arquivos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.jpg', { eager: true });
const fotos = Object.values(arquivos).map((m) => m.default);
---
<Base titulo="Fotos" descricao="Fotos das edições do Festival IgatuBoulder.">
  <Cabecalho rotulo="Fotos" titulo="Na pedra" />
  <section class="secao papel">
    <div class="conteudo">
      <ul class="galeria">
        {fotos.map((f, i) => (
          <li class="revela">
            <a href={f.src} target="_blank" rel="noopener">
              <Image src={f} alt={`Festival IgatuBoulder, foto ${i + 1}`} widths={[400, 800]} sizes="(max-width: 760px) 50vw, 33vw" loading="lazy" />
            </a>
          </li>
        ))}
      </ul>
      <p class="texto mais">Mais fotos no Instagram <a class="link" href={`https://instagram.com/${EVENTO.instagram}`}>@{EVENTO.instagram}</a>.</p>
    </div>
  </section>
</Base>
<style>
  .galeria { list-style: none; margin: 0; padding: 0; columns: 3 260px; column-gap: 12px; }
  .galeria li { break-inside: avoid; margin: 0 0 12px; }
  .galeria img { width: 100%; height: auto; border: 2px solid var(--verde); }
  .mais { margin-top: 32px; }
</style>
