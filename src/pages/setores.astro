---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import FotoAD from '../components/FotoAD.astro';
import MapaSetores from '../components/MapaSetores.astro';
import { SETORES } from '../data/setores';
import { FOTOS } from '../data/fotos';

const slug = (n: string) => n.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
const lista = SETORES.map((s, i) => ({ ...s, id: `setor-${slug(s.nome)}`, n: String(i + 1).padStart(2, '0'), fotos: FOTOS.filter((f) => f.setor === s.nome) }));
---
<Base titulo="Setores" descricao="Os setores de boulder ao redor de Igatu, na Chapada Diamantina.">
  <Cabecalho rotulo="Setores" titulo="Onde a gente escala">
    <p class="intro">Blocos de quartzito por todo lado. A maioria dos setores fica perto da vila; Califórnia, Coisa Boa e Degredo ficam mais afastados.</p>
  </Cabecalho>
  <section class="secao papel">
    <div class="conteudo">
      <MapaSetores />
      <ol class="setores">
        {lista.map((s) => (
          <li class="setor revela" id={s.id}>
            <span class="n">{s.n}</span>
            <h2 class="display nome">{s.nome}</h2>
            {s.fotos.length > 0 && (
              <div class="fotos">{s.fotos.slice(0, 3).map((f) => <FotoAD class="foto-setor" arquivo={f.arquivo} widths={[300, 600]} sizes="(max-width: 760px) 33vw, 160px" loading="lazy" />)}</div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
<style>
  .intro { max-width: 60ch; font-size: 18px; margin-top: 24px; }
  .setores { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0; border-top: 2px solid var(--verde); border-left: 2px solid var(--verde); }
  .setor { display: flex; flex-direction: column; gap: 6px; padding: 18px 18px 20px; border-right: 2px solid var(--verde); border-bottom: 2px solid var(--verde); min-width: 0; }
  .setor { scroll-margin-top: 90px; }
  .setor:target { background: var(--amarelo); }
  .n { font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--laranja); }
  .nome { font-size: clamp(34px, 4vw, 44px); color: var(--verde); text-transform: uppercase; margin: 0; }
  .fotos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 10px; }
  .fotos :global(.foto-setor) { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border: 1px solid var(--verde); }
</style>
