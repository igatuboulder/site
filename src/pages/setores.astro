---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import FotoAD from '../components/FotoAD.astro';
import { SETORES, linkMapa } from '../data/setores';
import { FOTOS } from '../data/fotos';

// Distância em linha reta do centro da vila (praça), em km.
const VILA = { lat: -12.8953, lon: -41.3197 };
const km = (lat: number, lon: number) => {
  const r = Math.PI / 180, dLat = (lat - VILA.lat) * r, dLon = (lon - VILA.lon) * r;
  const a = Math.sin(dLat / 2) ** 2 + Math.cos(VILA.lat * r) * Math.cos(lat * r) * Math.sin(dLon / 2) ** 2;
  return 6371 * 2 * Math.asin(Math.sqrt(a));
};
const fmt = (d: number) => d < 1 ? `${Math.round(d * 10) * 100} m` : `${d.toFixed(1).replace('.', ',')} km`;
const lista = SETORES.map((s, i) => ({ ...s, n: String(i + 1).padStart(2, '0'), dist: s.lat != null ? fmt(km(s.lat, s.lon!)) : null, mapa: linkMapa(s), fotos: FOTOS.filter((f) => f.setor === s.nome) }));
---
<Base titulo="Setores" descricao="Os setores de boulder ao redor de Igatu, na Chapada Diamantina.">
  <Cabecalho rotulo="Setores" titulo="Onde a gente escala">
    <p class="intro">Blocos de quartzito por todo lado. A maioria dos setores fica a uma caminhada curta da vila; Califórnia, Coisa Boa e Degredo ficam mais afastados.</p>
  </Cabecalho>
  <section class="secao papel">
    <div class="conteudo">
      <ol class="setores">
        {lista.map((s) => (
          <li class="setor revela">
            <span class="n">{s.n}</span>
            <h2 class="display nome">{s.nome}</h2>
            {s.dist && <p class="dist">{s.dist} da praça <span class="obs">(em linha reta)</span></p>}
            {s.mapa && <a class="mapa" href={s.mapa} target="_blank" rel="noopener">Abrir no mapa<span class="sr-only"> o setor {s.nome}</span> ↗</a>}
            {s.fotos.length > 0 && (
              <div class="fotos">{s.fotos.slice(0, 3).map((f) => <FotoAD class="foto-setor" arquivo={f.arquivo} widths={[300, 600]} sizes="(max-width: 760px) 33vw, 160px" loading="lazy" />)}</div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
<style>
  .intro { max-width: 60ch; font-size: 18px; margin-top: 24px; }
  .setores { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0; border-top: 2px solid var(--verde); border-left: 2px solid var(--verde); }
  .setor { display: flex; flex-direction: column; gap: 6px; padding: 18px 18px 20px; border-right: 2px solid var(--verde); border-bottom: 2px solid var(--verde); min-width: 0; }
  .n { font-family: var(--mono); font-size: 12px; font-weight: 600; color: var(--laranja); }
  .nome { font-size: clamp(34px, 4vw, 44px); color: var(--verde); text-transform: uppercase; margin: 0; }
  .dist { margin: 4px 0 0; font-size: 14px; }
  .obs { opacity: .65; font-size: 12px; }
  .mapa { margin-top: auto; padding-top: 10px; font-size: 13px; font-weight: 600; color: var(--verde); }
  .mapa:hover { color: var(--laranja); }
  .fotos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin-top: 10px; }
  .fotos :global(.foto-setor) { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border: 1px solid var(--verde); }
</style>
