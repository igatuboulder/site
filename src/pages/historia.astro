---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
const marcos = [
  { ano: '2013', titulo: '1ª edição', texto: 'Nos dias 25 e 26 de janeiro, cerca de 70 escaladores se reúnem nos setores Labirinto, Cemitério e Denorex. A inscrição custava R$ 20, e a campanha "Bote sua sapatilha" arrecadou sapatilhas para a molecada da vila.' },
  { ano: '2015', titulo: '3ª edição', texto: 'Cerca de 200 escaladores, inclusive do Chile e dos Estados Unidos. Novos setores, como Estrada Real e Coisa Boa, e uma competição para as crianças.' },
  { ano: '2019', titulo: '7ª edição', texto: 'O festival se firma no calendário da escalada brasileira, sempre no segundo fim de semana de janeiro.' },
  { ano: '2022', titulo: 'Nasce o IgatuBoulder Social', texto: 'O festival passa a levar médicos, dentistas e voluntários para atender os moradores de Igatu.' },
  { ano: '2023', titulo: '10ª edição', texto: 'Mais de 100 atendimentos de saúde durante o festival. A edição vira documentário.' },
  { ano: '2027', titulo: '14ª edição', texto: 'De 8 a 10 de janeiro. Vem com a gente.' },
];
---
<Base titulo="História" descricao="A história do Festival IgatuBoulder, da primeira edição à 14ª.">
  <Cabecalho rotulo="História" titulo="Da primeira à 14ª">
    <p class="intro">O IgatuBoulder nasceu da escalada na vila e da vontade de que ela fizesse bem para quem mora ali. À frente, desde o começo, está a equipe IgatuLands.</p>
  </Cabecalho>
  <section class="secao papel">
    <ol class="linha conteudo">
      {marcos.map((m) => (
        <li class="revela"><span class="ano display">{m.ano}</span><div><h2>{m.titulo}</h2><p>{m.texto}</p></div></li>
      ))}
    </ol>
  </section>
</Base>
<style>
  .intro { max-width: 60ch; font-size: 18px; margin-top: 24px; }
  .linha { list-style: none; padding: 0; border-left: 2px solid var(--verde); }
  .linha li { display: grid; grid-template-columns: 200px 1fr; gap: 24px; padding: 0 0 48px 28px; position: relative; }
  .linha li::before { content: ''; position: absolute; left: -9px; top: 14px; width: 16px; height: 16px; background: var(--amarelo); border: 2px solid var(--verde); border-radius: 50%; }
  .ano { font-size: 72px; color: var(--verde); }
  h2 { font-family: var(--display); font-weight: 900; font-stretch: 75%; font-size: 30px; line-height: 1; text-transform: uppercase; margin: 6px 0 8px; color: var(--verde); }
  .linha p { margin: 0; max-width: 60ch; font-size: 16px; }
  @media (max-width: 640px) { .linha li { grid-template-columns: 1fr; gap: 4px; } .ano { font-size: 56px; } }
</style>
