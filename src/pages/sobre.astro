---
import FotoAD from '../components/FotoAD.astro';
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import FaixaFotos from '../components/FaixaFotos.astro';
import { EVENTO } from '../config/evento';
const frentes = [
  { nome: 'IgatuBoulder', sub: 'Festival', texto: 'Escalada, turismo, cultura, natureza, esporte e economia local. É o que traz visitantes, movimenta a vila e cria experiências através do esporte e da cultura.' },
  { nome: 'IgatuBoulder Social', sub: 'Braço social', texto: 'Saúde, educação, esporte, cultura, meio ambiente e voluntariado. Ações gratuitas feitas com profissionais voluntários, parceiros e apoiadores, para quem mora em Igatu.' },
];
const acoes = [
  { t: 'Mutirão de limpeza', d: 'Por trás de toda área de escalada existe um cuidado constante com a rocha e com o ambiente. O mutirão junta escaladores e crianças da vila para limpar e conservar os setores.' },
  { t: 'Escalada com as crianças', d: 'Uma manhã de escalada com os pequenos guerreiros de pedra de Igatu, para estimular o esporte, a convivência e a qualidade de vida.' },
  { t: 'Cine de montanha', d: 'Sessões com filmes e curtas brasileiros de escalada, para valorizar a produção nacional e mostrar à comunidade o universo da escalada pelo cinema.' },
];
---
<Base titulo="Sobre" descricao="O que é o Festival IgatuBoulder e o IgatuBoulder Social.">
  <Cabecalho rotulo="Sobre" titulo="O festival" />
  <section class="secao papel">
    <div class="conteudo duas">
      <div class="texto revela">
        <p class="rotulo">Retorno à comunidade</p>
        <h2 class="display h2">Feito com a vila</h2>
        <p>O festival é feito pela equipe IgatuLands, com jovens de Igatu. A organização, a logística, a limpeza e a manutenção das áreas de escalada e de convivência usam mão de obra local.</p>
        <p>Durante os três dias, quem vem escalar se hospeda, come, compra artesanato e contrata guias na vila. E o festival inspira os moradores, principalmente crianças e adolescentes, a praticar esportes de aventura.</p>
        <p>O IgatuBoulder é um festival de escalada em blocos em Igatu, vila histórica do garimpo no município de Andaraí, no coração da Chapada Diamantina.</p>
        <p>São três dias de escalada nos setores ao redor da vila, encontros, festa e convivência com quem vive ali. O festival acontece em janeiro e a {EVENTO.edicao}ª edição será de {EVENTO.datas}.</p>
        <p>O apelido IgatuLands é uma homenagem a Rocklands, na África do Sul, um dos destinos de boulder mais famosos do mundo.</p>
      </div>
      <FotoAD class="foto revela" arquivo="IMG_6444" widths={[600, 1000]} sizes="(max-width: 760px) 100vw, 50vw" />
    </div>
  </section>
  <section class="secao grade">
    <div class="conteudo">
      <p class="rotulo">14ª edição</p>
      <h2 class="display h2">Duas frentes, um propósito</h2>
      <div class="frentes">
        {frentes.map((f) => <article class="frente revela"><p class="rotulo">{f.sub}</p><h3 class="display h3">{f.nome}</h3><p>{f.texto}</p></article>)}
      </div>
    </div>
  </section>
  <section class="secao papel">
    <div class="conteudo duas">
      <FotoAD class="foto revela" arquivo="IMG_1105" widths={[600, 1000]} sizes="(max-width: 760px) 100vw, 50vw" />
      <div class="texto revela">
        <p class="rotulo">Saúde na vila</p>
        <h2 class="display h2">IgatuBoulder Social</h2>
        <p>O IgatuBoulder Social é a razão de o festival existir. Desde 2022, durante o festival, médicos, dentistas e outros voluntários fazem atendimentos para os moradores de Igatu. Em 2023 foram mais de 100 atendimentos.</p>
        <p>Em 2027, o Social amplia a atuação para saúde, educação, esporte, cultura, meio ambiente e voluntariado, com atendimentos básicos como odontologia, fisioterapia, psicomotricidade e acompanhamento psicossocial.</p>
        <p>A vila tem cerca de 500 moradores, e boa parte do que o festival movimenta fica na comunidade.</p>
      </div>
    </div>
  </section>
  <section class="secao grade">
    <div class="conteudo">
      <p class="rotulo">Responsabilidade ambiental</p>
      <h2 class="display h2">Cuidar da pedra e da vila</h2>
      <div class="acoes">
        {acoes.map((a) => <article class="acao revela"><h3 class="display h3">{a.t}</h3><p>{a.d}</p></article>)}
      </div>
      <div class="fotos-cuidado"><FaixaFotos arquivos={['pp-escalada-agarra', 'pp-vila-rio', 'pp-social-menino']} proporcao="4 / 3" /></div>
    </div>
  </section>
</Base>
<style>
  .duas :global(.foto) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border: 2px solid var(--verde); }
  .frentes, .acoes { display: grid; gap: 16px; }
  .fotos-cuidado { margin-top: 16px; }
  .frentes { grid-template-columns: repeat(2, 1fr); }
  .acoes { grid-template-columns: repeat(3, 1fr); }
  .frente, .acao { background: var(--papel); border: 2px solid var(--verde); padding: 24px; }
  .frente p:last-child, .acao p { margin: 0; }
  @media (max-width: 760px) { .frentes, .acoes { grid-template-columns: 1fr; } }
</style>
