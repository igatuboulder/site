---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NomeSvg from '../components/NomeSvg.astro';
import Ticket from '../components/Ticket.astro';
import { EVENTO } from '../config/evento';
import f1 from '../assets/fotos/IMG_6446.jpg';
import f2 from '../assets/fotos/IMG_6406.jpg';
import f3 from '../assets/fotos/IMG_1322.jpg';
import f4 from '../assets/fotos/IMG_6462.jpg';
const destaques = [
  { href: '/sobre', rotulo: 'O festival', titulo: 'Três dias de boulder em Igatu' },
  { href: '/historia', rotulo: 'História', titulo: 'Da primeira edição à 14ª' },
  { href: '/fotos', rotulo: 'Fotos', titulo: 'Os blocos, a vila, a galera' },
];
---
<Base>
  <section class="hero grade">
    <div class="barra">
      <div><strong>Festival de escalada</strong><span>Chapada Diamantina</span></div>
      <div class="dir"><strong>Igatu · Chapada Diamantina · BA</strong><span>12°53′47″S · 41°19′07″W</span></div>
    </div>
    <h1 class="sr-only">IgatuBoulder — {EVENTO.edicao}º Festival de escalada, {EVENTO.datas}</h1>
    <div class="nome" aria-hidden="true">
      <NomeSvg />
      <img class="escalador" src="/img/escalador.png" alt="" width="133" height="250" />
    </div>
    <div class="edicao">
      <div class="placa display">{EVENTO.edicao}<sup>ª</sup></div>
      <div class="festival">
        <p class="display titulo">Festival<br />de escalada</p>
        <p class="data"><strong>{EVENTO.datas}</strong><span>{EVENTO.dias}</span></p>
      </div>
    </div>
    <div class="ticket-wrap"><Ticket href="/inscricao" /></div>
  </section>

  <section class="faixa" aria-label="Fotos do festival">
    {[f1, f2, f3, f4].map((f) => <Image src={f} alt="" widths={[400, 800]} sizes="(max-width: 760px) 50vw, 25vw" />)}
  </section>

  <section class="secao papel">
    <div class="conteudo">
      <img class="rocha revela" src="/img/id-ig-simbolo.png" alt="" width="693" height="369" loading="lazy" />
      <p class="display mote revela">Não é meu evento,<br />é o nosso evento</p>
      <div class="cards">
        {destaques.map((d) => (
          <a class="card revela" href={d.href}><span class="rotulo">{d.rotulo}</span><span class="display">{d.titulo}</span><span class="seta">→</span></a>
        ))}
      </div>
    </div>
  </section>

  <script>
    import { gsap } from 'gsap';
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      gsap.timeline({ defaults: { ease: 'power3.out' } })
        .from('.nome-svg text, .nome-svg rect', { yPercent: 12, opacity: 0, duration: 0.9, stagger: 0.08 })
        .from('.escalador', { y: -40, rotate: -12, opacity: 0, duration: 0.8, ease: 'back.out(2)', transformOrigin: '30% 0%' }, '-=0.4')
        .from('.edicao > *, .ticket-wrap', { y: 24, opacity: 0, duration: 0.6, stagger: 0.1 }, '-=0.4');
    });
  </script>
</Base>

<style>
  .hero { padding: 28px var(--margem) 56px; }
  .barra { max-width: 1100px; margin: 0 auto; display: flex; justify-content: space-between; gap: 16px; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .barra div { display: flex; flex-direction: column; gap: 4px; }
  .barra .dir { text-align: right; }
  .nome { position: relative; margin: 24px auto 0; max-width: 900px; aspect-ratio: 800 / 560; }
  .nome :global(.nome-svg) { width: 100%; height: 100%; overflow: visible; }
  .escalador { position: absolute; left: 67.4%; top: 3.9%; width: 16.6%; height: auto; filter: drop-shadow(3px 0 0 var(--amarelo)) drop-shadow(-3px 0 0 var(--amarelo)) drop-shadow(0 3px 0 var(--amarelo)) drop-shadow(0 -3px 0 var(--amarelo)); }
  .edicao { display: flex; gap: 20px; max-width: 900px; margin: 32px auto 0; align-items: stretch; }
  .placa { background: var(--verde); color: var(--papel); font-size: clamp(90px, 16vw, 150px); padding: 14px 18px 10px; display: flex; align-items: flex-start; }
  .placa sup { font-size: .2em; font-stretch: 100%; margin: 6px 0 0 4px; line-height: 1; }
  .festival { flex: 1; display: flex; flex-direction: column; justify-content: space-between; color: var(--verde); }
  .titulo { margin: 0; font-stretch: 100%; font-size: clamp(36px, 7.5vw, 64px); text-transform: uppercase; }
  .data { margin: 12px 0 0; display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; }
  .data strong { line-height: 1.1; font-family: var(--display); font-weight: 900; font-stretch: 75%; font-size: clamp(22px, 3.5vw, 28px); }
  .data span { font-size: 14px; font-weight: 600; letter-spacing: .06em; }
  .ticket-wrap { max-width: 900px; margin: 32px auto 0; }
  .faixa { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: hidden; border-top: 2px solid var(--verde); border-bottom: 2px solid var(--verde); }
  .faixa img { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; }
  .rocha { width: clamp(160px, 22vw, 260px); height: auto; margin: 0 0 24px; }
  .mote { line-height: .95; font-size: clamp(48px, 9vw, 112px); color: var(--verde); text-transform: uppercase; margin: 0 0 48px; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .card { display: flex; flex-direction: column; gap: 12px; padding: 24px; border: 2px solid var(--verde); text-decoration: none; color: var(--verde); min-height: 200px; transition: background .2s, color .2s, transform .25s cubic-bezier(.2,.8,.2,1.2); }
  .card .display { line-height: 1; font-size: 34px; font-stretch: 75%; text-transform: uppercase; }
  .card .seta { margin-top: auto; font-size: 28px; }
  .card:hover { background: var(--verde); color: var(--papel); transform: translateY(-4px); }
  @media (max-width: 400px) { .titulo { font-size: 30px; } .placa { font-size: 76px; } }
  @media (max-width: 760px) { .faixa { grid-template-columns: repeat(2, minmax(0, 1fr)); } .cards { grid-template-columns: 1fr; } .barra { font-size: 10px; flex-direction: column; gap: 10px; } .barra .dir { text-align: left; } }
</style>
