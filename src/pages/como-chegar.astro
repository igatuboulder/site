---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
const passos = [
  { de: 'Salvador', para: 'Andaraí', km: '~410 km', d: 'Quem vem de avião pode descer no Aeroporto de Salvador, que tem voos de todo o país. De carro são cerca de 6 horas pela BR-324 até Feira de Santana, depois BR-116, BR-242 e BA-142 até Andaraí. De ônibus, há linhas saindo da Rodoviária de Salvador para Andaraí; são poucos horários por dia, então vale comprar a passagem com antecedência.' },
  { de: 'Lençóis', para: 'Andaraí', km: '~100 km', d: 'Lençóis é a porta de entrada da Chapada e o aeroporto de Lençóis recebe voos regionais em algumas épocas do ano; confira as companhias antes de comprar. De Lençóis até Andaraí é cerca de 1h30 de carro pela BR-242 e BA-142. Também dá para combinar táxi ou transfer na cidade.' },
  { de: 'Andaraí', para: 'Igatu', km: '14 km', d: 'O último trecho é uma estrada de pedra que sobe a serra, uns 40 minutos de carro. Carro comum passa, devagar e com atenção, principalmente se chover. Sem carro, dá para subir de mototáxi ou combinar transporte no centro de Andaraí.' },
];
const MAPA = 'https://www.google.com/maps?q=Igatu,+Andara%C3%AD+-+BA&z=12&output=embed';
---
<Base titulo="Como chegar" descricao="Como chegar em Igatu, Andaraí, Chapada Diamantina.">
  <Cabecalho rotulo="Como chegar" titulo="Até Igatu" />
  <section class="secao papel">
    <ol class="passos conteudo">
      {passos.map((p, i) => (
        <li class="revela">
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="display h3 rota"><span>{p.de}</span> <span class="ate"><span class="seta" aria-label="até">→</span> {p.para}</span></h2>
          <p class="display h3 km">{p.km}</p>
          <p class="d">{p.d}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="secao grade">
    <div class="conteudo duas">
      <div class="texto revela">
        <h2 class="display h3">Onde ficar</h2>
        <p>A vila tem pousadas, casas de moradores e camping. Reserve cedo: em janeiro a vila enche.</p>
        <h2 class="display h3">Leve</h2>
        <p>Sapatilha, crash pad se tiver, lanterna, protetor solar e garrafa d'água.</p>
      </div>
      <div class="mapa revela">
        <iframe title="Mapa de Igatu, Andaraí, Bahia" src={MAPA} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
      </div>
    </div>
  </section>
</Base>
<style>
  .passos { list-style: none; padding: 0; border-top: 2px solid var(--verde); }
  .passos li { display: grid; grid-template-columns: 48px minmax(0, 1fr) auto; grid-template-areas: 'n rota km' 'n d d'; column-gap: 20px; row-gap: 6px; align-items: baseline; padding: 28px 0; border-bottom: 2px solid var(--verde); }
  .n { grid-area: n; font-family: var(--mono); font-size: var(--t-nota); font-weight: 600; color: var(--laranja-texto); }
  .rota { grid-area: rota; margin: 0; }
  .seta { color: var(--laranja); font-stretch: 100%; }
  .ate { white-space: nowrap; }
  .km { grid-area: km; margin: 0; color: var(--laranja-texto); white-space: nowrap; }
  .d { grid-area: d; margin: 0; max-width: 60ch; }
  .mapa { border: 2px solid var(--verde); background: var(--papel); aspect-ratio: 4 / 3; max-width: 100%; }
  .mapa iframe { display: block; width: 100%; height: 100%; border: 0; }
  @media (max-width: 760px) {
    .passos li { grid-template-columns: 32px minmax(0, 1fr); grid-template-areas: 'n rota' 'n km' 'n d'; }
    .mapa { aspect-ratio: 1; }
  }
</style>
