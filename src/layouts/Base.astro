---
import '../styles/global.css';
import IconeInstagram from '../components/IconeInstagram.astro';
import { EVENTO } from '../config/evento';
import { PAGINAS } from '../data/navegacao';
import { REALIZACAO, PATROCINIO, APOIOS, type Parceiro } from '../data/parceiros';
interface Props { titulo?: string; descricao?: string }
const { titulo, descricao } = Astro.props;
const tituloFinal = titulo ? `${titulo} · IgatuBoulder ${EVENTO.ano}` : `${EVENTO.nome} ${EVENTO.ano} · ${EVENTO.edicao}ª edição`;
const desc = descricao ?? `${EVENTO.edicao}º Festival IgatuBoulder, ${EVENTO.datas}, em Igatu, Chapada Diamantina.`;
const grupos: [string, Parceiro[], string?][] = [['Realização', REALIZACAO], ['Patrocínio', PATROCINIO, 'patrocinio'], ['Apoio', APOIOS, 'apoio']];
const atual = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{tituloFinal}</title>
  <meta name="description" content={desc} />
  <meta name="theme-color" content="#DDA548" />
  <meta property="og:title" content={tituloFinal} />
  <meta property="og:description" content={desc} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <script is:inline>try { if (localStorage.getItem('ib-ad') === '1') document.documentElement.dataset.ad = 'on'; } catch (e) {}</script>
</head>
<body>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <div class="acess" role="region" aria-label="Acessibilidade">
    <span class="rotulo">Acessibilidade</span>
    <button type="button" id="btn-ad" aria-pressed="false" title="Mostra na tela a descrição de cada foto">Audiodescrição</button>
    <button type="button" id="btn-ouvir" aria-pressed="false" hidden title="Lê em voz alta o texto e as descrições das fotos">Ouvir a página</button>
    <button type="button" id="btn-libras" title="Abre o tradutor de Libras (VLibras)">Libras</button>
  </div>
  <nav class="nav" aria-label="Principal">
    <a class="marca" href="/" aria-label="Início"><img src="/img/id-ig-simbolo.png" alt="" width="693" height="369" /><span class="marca-txt"><span>IGATU</span><span>BOULDER</span></span></a>
    <details class="menu">
      <summary>Menu</summary>
      <ul>
        {PAGINAS.map((p) => <li><a href={p.href} aria-current={atual === p.href ? 'page' : undefined}>{p.rotulo}</a></li>)}
      </ul>
    </details>
    <ul class="links">
      {PAGINAS.map((p) => <li><a href={p.href} aria-current={atual === p.href ? 'page' : undefined}>{p.rotulo}</a></li>)}
    </ul>
    <a class="inscreva" href="/inscricao" aria-current={atual === '/inscricao' ? 'page' : undefined}>Inscreva-se</a>
  </nav>

  <main id="conteudo"><slot /></main>

  <footer class="rodape grade">
    <div class="parceiros">
      {grupos.map(([rotulo, lista, cls]) => (
        <div class:list={['grupo', cls]}><p class="rotulo">{rotulo}</p><div class="logos">
          {lista.map((p) => p.arquivo ? <img src={`/img/logos/${p.arquivo}.png`} alt={p.nome} loading="lazy" /> : <span class="nome-parceiro">{p.nome.toUpperCase()}</span>)}
        </div></div>
      ))}
    </div>
    <div class="base">
      <img class="logo-ib" src="/img/logos/igatuboulder.png" alt="IgatuBoulder Festival" width="660" height="282" loading="lazy" />
      <img class="logo-id" src="/img/id-ig-estilizada.png" alt="IgatuBoulder" width="693" height="604" loading="lazy" />
      <p><a class="ig" href={`https://instagram.com/${EVENTO.instagram}`} target="_blank" rel="noopener"><IconeInstagram /> @{EVENTO.instagram}</a></p>
      <p>{EVENTO.datas}<br />{EVENTO.local}</p>
    </div>
  </footer>

  <!-- VLibras: tradutor de Libras do Governo Federal (vlibras.gov.br) -->
  <div vw class="enabled">
    <div vw-access-button class="active"></div>
    <div vw-plugin-wrapper><div class="vw-plugin-top-wrapper"></div></div>
  </div>
  <script is:inline src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
  <script is:inline>if (window.VLibras) new window.VLibras.Widget('https://vlibras.gov.br/app');</script>

  <script>
    import { dividirEmTrechos } from '../lib/leitura';
    // Audiodescrição: mostra/esconde as descrições das fotos (o leitor de tela já lê sempre).
    const btnAd = document.getElementById('btn-ad')!;
    const raiz = document.documentElement;
    const marcarAd = () => btnAd.setAttribute('aria-pressed', String(raiz.dataset.ad === 'on'));
    marcarAd();
    btnAd.addEventListener('click', () => {
      const ligar = raiz.dataset.ad !== 'on';
      if (ligar) raiz.dataset.ad = 'on'; else delete raiz.dataset.ad;
      try { localStorage.setItem('ib-ad', ligar ? '1' : '0'); } catch {}
      marcarAd();
    });

    // Ouvir a página: lê o conteúdo principal em voz alta, incluindo as audiodescrições.
    const btnOuvir = document.getElementById('btn-ouvir')!;
    if ('speechSynthesis' in window) {
      btnOuvir.hidden = false;
      const fala = window.speechSynthesis;
      const parar = () => { fala.cancel(); btnOuvir.setAttribute('aria-pressed', 'false'); btnOuvir.textContent = 'Ouvir a página'; };
      const textoDaPagina = () => {
        const partes: string[] = [];
        const andar = (el: Element) => {
          if (el.matches('script, style, [aria-hidden="true"], .ad-rotulo')) return;
          if (el.matches('h1, h2, h3, p, li, figcaption, dt, dd, label, legend, button, summary') && !el.querySelector('p, li, h2, h3, figcaption')) {
            const t = (el.textContent ?? '').replace(/\s+/g, ' ').trim();
            if (t) partes.push(/[.!?:]$/.test(t) ? t : t + '.');
            return;
          }
          for (const filho of Array.from(el.children)) andar(filho);
        };
        andar(document.getElementById('conteudo')!);
        return partes.join(' ');
      };
      btnOuvir.addEventListener('click', () => {
        if (btnOuvir.getAttribute('aria-pressed') === 'true') return parar();
        fala.cancel();
        const voz = fala.getVoices().find((v) => v.lang.toLowerCase().startsWith('pt-br')) ?? fala.getVoices().find((v) => v.lang.toLowerCase().startsWith('pt'));
        const trechos = dividirEmTrechos(textoDaPagina());
        trechos.forEach((t, i) => {
          const u = new SpeechSynthesisUtterance(t);
          u.lang = 'pt-BR';
          if (voz) u.voice = voz;
          if (i === trechos.length - 1) u.onend = parar;
          fala.speak(u);
        });
        btnOuvir.setAttribute('aria-pressed', 'true');
        btnOuvir.textContent = 'Parar leitura';
      });
      window.addEventListener('pagehide', () => fala.cancel());
    }

    // Libras: abre o VLibras pelo botão da barra.
    document.getElementById('btn-libras')!.addEventListener('click', () => {
      (document.querySelector('[vw-access-button]') as HTMLElement | null)?.click();
    });
  </script>

  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);
    gsap.matchMedia().add('(prefers-reduced-motion: no-preference)', () => {
      // Sol: nasce ao abrir a página e acompanha o scroll (desce ao rolar para baixo, sobe ao voltar).
      gsap.from('.cab .sol', { y: () => document.querySelector('.cab .sol')?.clientHeight! * 0.45, duration: 1.4, ease: 'power3.out' });
      gsap.to('.cab .sol', { yPercent: 70, ease: 'none', scrollTrigger: { trigger: '.cab', start: 'top top', end: 'bottom top', scrub: 0.6 } });
      gsap.utils.toArray<HTMLElement>('.revela').forEach((el) => {
        gsap.from(el, { y: 28, opacity: 0, duration: 0.7, ease: 'power2.out', scrollTrigger: { trigger: el, start: 'top 88%', once: true } });
      });
    });
  </script>
</body>
</html>

<style>
  .pular { position: absolute; left: -9999px; }
  .pular:focus { left: 16px; top: 16px; z-index: 10; background: var(--papel); padding: 8px 12px; }
  .nav { position: sticky; top: 0; z-index: 5; display: flex; align-items: center; gap: 24px; padding: 12px var(--margem); background: var(--amarelo); border-bottom: 2px solid var(--verde); }
  .marca { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .marca img { width: 64px; height: auto; }
  .marca-txt { display: flex; flex-direction: column; text-decoration: none; font-family: var(--display); font-weight: 900; font-stretch: 62%; font-size: 20px; line-height: .85; color: var(--verde); }
  .links { display: flex; gap: 22px; list-style: none; margin: 0 0 0 auto; padding: 0; }
  .links a, .menu a { text-decoration: none; font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; padding: 6px 0; border-bottom: 2px solid transparent; }
  .links a:hover, .links a[aria-current] { border-bottom-color: var(--verde); }
  .inscreva { display: inline-flex; align-items: center; font-family: var(--display); font-weight: 900; font-stretch: 75%; font-size: 20px; text-decoration: none; background: var(--verde); color: var(--papel); padding: 8px 16px; white-space: nowrap; transition: transform .2s cubic-bezier(.22,1,.36,1); }
  .inscreva:hover { transform: translateY(-2px); }
  .menu { display: none; margin-left: auto; }
  .menu summary { display: flex; align-items: center; list-style: none; cursor: pointer; font-size: 13px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; border: 2px solid var(--verde); padding: 6px 12px; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu ul { position: absolute; left: 0; right: 0; top: 100%; background: var(--amarelo); border-bottom: 2px solid var(--verde); list-style: none; margin: 0; padding: 8px var(--margem) 16px; }
  .menu li a { display: block; padding: 12px 0; font-size: 16px; }
  @media (max-width: 900px) { .links { display: none; } .menu { display: block; } }
  @media (max-width: 480px) { .nav { gap: 12px; } .marca img { width: 44px; } .inscreva { font-size: 17px; padding: 8px 12px; } }
  .rodape { padding: 48px var(--margem) 32px; border-top: 2px solid var(--verde); }
  .parceiros { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1.2fr .8fr 2fr; gap: 24px; padding-bottom: 32px; border-bottom: 1px solid var(--verde); }
  .grupo .logos { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; }
  .grupo img { height: 46px; width: auto; }
  .patrocinio img { height: 52px; }
  .acess { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; padding: 6px var(--margem); background: var(--verde); color: var(--papel); }
  .acess .rotulo { margin-right: auto; }
  .acess button { font: 600 12px/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--papel); background: none; border: 1px solid var(--papel); padding: 6px 10px; cursor: pointer; }
  .acess button:hover, .acess button[aria-pressed='true'] { background: var(--papel); color: var(--verde); }
  /* toque: 44px onde o dedo é o ponteiro; no celular a barra de acessibilidade cabe numa linha */
  @media (pointer: coarse), (max-width: 600px) { .acess button, .menu summary, .inscreva, .marca { min-height: 44px; } }
  @media (max-width: 600px) {
    .acess { flex-wrap: nowrap; gap: 6px; }
    .acess .rotulo { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .acess button { flex: 1; font-size: 11px; letter-spacing: .04em; padding: 6px 4px; }
  }
  .nome-parceiro { font-family: var(--display); font-weight: 900; font-stretch: 75%; font-size: 20px; color: var(--verde); }
  .base { max-width: 1100px; margin: 0 auto; padding-top: 28px; display: grid; grid-template-columns: 180px 110px 1fr 1fr; gap: 24px; align-items: center; font-size: 14px; }
  .base p { margin: 0; }
  .ig { display: inline-flex; align-items: center; gap: 8px; }
  .logo-ib, .logo-id { width: 100%; height: auto; }
  @media (max-width: 760px) { .parceiros, .base { grid-template-columns: 1fr; } .logo-ib { max-width: 160px; } .logo-id { max-width: 110px; } }
</style>
