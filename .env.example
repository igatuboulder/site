# Variáveis do servidor. Os valores ficam SÓ na Netlify (Project configuration → Environment variables), nunca aqui.
INFINITEPAY_HANDLE=        # InfiniteTag da conta que recebe, sem o $
INFINITEPAY_API_KEY=       # opcional: chave inchk_… (necessária para repassar a taxa do cartão)
SUPABASE_SECRET_KEY=       # chave secreta do Supabase (Production e Deploy Previews apenas)
